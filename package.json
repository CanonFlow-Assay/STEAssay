{
  "name": "ste-assay",
  "version": "0.1.0",
  "description": "Deterministic verifier for mechanically decidable controlled technical writing policy",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.20.2",
    "npm": "10.8.2"
  },
  "packageManager": "npm@10.8.2",
  "bin": {
    "ste-assay": "./dist/src/cli.js"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests/*.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && node --test dist/tests/assay.test.js",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "fast-glob": "3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.5",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.18.0"
  }
}
